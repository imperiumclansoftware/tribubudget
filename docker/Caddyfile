{
	# HTTP only: put a reverse proxy in front for HTTPS
	auto_https off
	admin off
	frankenphp
}

:80 {
	root * /app/public
	encode zstd br gzip

	# PHP only runs behind /api: no PHP source is ever served as a file
	@php path *.php
	handle @php {
		respond 404
	}

	# API: Symfony
	@api path /api/*
	handle @api {
		php_server
	}

	# Angular application: files, or index.html for its routes
	handle {
		@html path / /index.html
		header @html Cache-Control "no-cache"
		header /*.js Cache-Control "public, max-age=31536000, immutable"
		header /*.css Cache-Control "public, max-age=31536000, immutable"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		try_files {path} /index.html
		file_server
	}
}
