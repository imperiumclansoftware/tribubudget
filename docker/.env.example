# Optional settings of TribuBudget: copy this file to .env next to compose.yaml.
# The secrets and the database are created at the first start: nothing else to fill in.

# Port of the server where TribuBudget answers (http://<server>:8080)
TRIBUBUDGET_PORT=8080
# Version of the image (latest, or a fixed version such as 0.2.0)
TRIBUBUDGET_VERSION=latest

APP_TIMEZONE=Europe/Paris
