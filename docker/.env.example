# Settings of TribuBudget: copy this file to .env next to compose.yaml, then fill it in.
# Secrets: generate each with   openssl rand -hex 32

# Port of the server where TribuBudget answers (http://<server>:8080)
TRIBUBUDGET_PORT=8080
# Version of the image (latest, or a fixed version such as 0.1.0)
TRIBUBUDGET_VERSION=latest

APP_SECRET=
JWT_PASSPHRASE=
# Password of the database: never change it once the database volume exists
POSTGRES_PASSWORD=

APP_TIMEZONE=Europe/Paris
